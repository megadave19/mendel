# Mendel — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database path (relative to project root)
DATABASE_URL="file:./prisma/dev.db"

# Encryption key for storing GitHub PATs at rest (AES-256-GCM)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters.
ENCRYPTION_KEY="REPLACE_ME_run_openssl_rand_base64_32_and_paste_here"

# ─────────────────────────────────────────────────────────────────────────────
# Required for scanning (optional to get the app to boot)
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Personal Access Token
# Scopes needed: repo, read:user
# Generate at: https://github.com/settings/tokens
GITHUB_PAT=""

# Google Gemini API Key
# Free tier available at: https://aistudio.google.com/
GEMINI_API_KEY=""
