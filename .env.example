# Mendel — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database path (relative to project root)
DATABASE_URL="file:./prisma/dev.db"

# Encryption key for storing GitHub PATs at rest (AES-256-GCM)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters.
ENCRYPTION_KEY="REPLACE_ME_run_openssl_rand_base64_32_and_paste_here"

# ─────────────────────────────────────────────────────────────────────────────
# Required for scanning (optional to get the app to boot)
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Personal Access Token
# Scopes needed: repo, read:user
# Generate at: https://github.com/settings/tokens
GITHUB_PAT=""

# ─────────────────────────────────────────────────────────────────────────────
# LLM provider (default: gemini). The agent is provider-agnostic.
# ─────────────────────────────────────────────────────────────────────────────

# Which provider to use: "gemini" (default) or "github-models" (free fallback).
LLM_PROVIDER="gemini"

# --- Provider: Gemini (default) ---
# Free tier available at: https://aistudio.google.com/
GEMINI_API_KEY=""
# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# --- Provider: GitHub Models (free, OpenAI-compatible) ---
# Set LLM_PROVIDER="github-models" to use these.
# Token: a GitHub PAT with "models" access — https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=""
# Model (default: gpt-4o-mini). Options include gpt-4o, gpt-4o-mini, etc.
# GITHUB_MODELS_MODEL="gpt-4o-mini"
# Endpoint (default: https://models.github.ai/inference)
# GITHUB_MODELS_BASE_URL="https://models.github.ai/inference"
