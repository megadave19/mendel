# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
build/
dist/

# Environment files — never commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local runtime data — user repo clones and sandbox state
workspace/
logs/

# pnpm content-addressable store (created by sandbox runs inside fixtures)
.pnpm-store/

# Database files — match anywhere (incl. nested prisma/prisma/dev.db from a
# relative DATABASE_URL). These hold runtime scan data + encrypted PATs.
*.db
*.db-journal
*.db-wal
*.db-shm
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Playwright test artifacts
test-results/
playwright-report/

# Python bytecode cache (from skill scripts)
__pycache__/
*.pyc

# 3D model source (only the optimized public/mascot/bones.glb is committed)
Meshy_AI_Neon_Bearded_Skeleton_biped/
bones-model.zip

# Original-resolution mascot source art (17MB) — runtime uses the optimized
# public/mascot/bones-*.png; keep originals local only.
public/mascot/_orig/
