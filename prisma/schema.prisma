// Mendel data model — TRD §10

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Scan {
  id            String    @id @default(cuid())
  repoUrl       String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String
  issuesFound   Int       @default(0)
  prsOpened     Int       @default(0)
  totalTokens   Int       @default(0)
  schemaVersion String
  /// AES-256-GCM encrypted GitHub PAT (iv:authTag:ciphertext, all hex)
  encryptedPat  String?
  /// JSON string[] of the repo's dependency names (for the 3D dep graph)
  deps          String?
  /// Captured failure reason (Fix #2 — was emit-only via SSE, lost after the fact)
  errorMessage  String?
  /// v1.5 W#6 — aggregated calibration summary across this scan's issues.
  /// JSON-stringified ScanConfidenceSummary (see lib/agent/confidence/summary.ts).
  /// Null for v1.0 scans + scans where no issue had calibrated confidence data.
  confidenceSummary String?
  /// v2.0 / F20 — true when this scan opted into Phase C smoke-test.
  /// Read by /scan/[id] to know whether to render the 5th StageLane.
  /// Default false → v1.5 scans render the 4-lane view unchanged.
  smokeRequested Boolean @default(false)
  /// v2.1 / F21 — the workspace flavor detected by lib/agent/workspace/detect.ts:
  /// 'single' | 'pnpm' | 'npm' | 'yarn' | 'lerna' | 'nx' | 'turbo'. Null on
  /// legacy v1.5 scans (back-compat). Drives UI (monorepo line on S3, package
  /// chips on IssueCard, mini-stats on S4).
  workspaceKind String?
  issues        Issue[]
  packages      ScanPackage[]
}

/// v2.1 / F21 — one row per member package enumerated by detectWorkspace().
/// For a single-package scan there's still one row with dir='.', so the
/// runtime never branches on "is this a monorepo?" — single is the N=1
/// special case (V2_PLAN.md §F21 integration rule).
model ScanPackage {
  id           String   @id @default(cuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  /// From the member package's own package.json `name`. Falls back to dir.
  name         String
  /// Path RELATIVE to the workspace root, e.g. 'packages/ui' or '.' for root.
  dir          String
  /// Path to that package's package.json, relative to the workspace root.
  manifestPath String
  /// Count of dependencies declared by THIS package (best-effort, summed
  /// across deps/devDeps/peerDeps). Used to rank packages under budget.
  depsCount    Int      @default(0)
  /// Count of issues opened for THIS package in this scan. Filled in by
  /// the runner as it iterates so the dashboard can show per-package stats.
  issuesFound  Int      @default(0)
  /// True iff the runner SCANNED this package; false iff it skipped under
  /// token budget (we still persist the row so "Not Analyzed" can name it).
  scanned      Boolean  @default(true)
  /// Reason a package was skipped (budget, error, etc.) — §5b honest.
  skipReason   String?
  createdAt    DateTime @default(now())

  @@index([scanId])
}

model Issue {
  id           String   @id @default(cuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id])
  type         String
  severity     String
  confidence   String   // JSON stringified — SQLite has no native JSON
  diagnosis    String   // JSON stringified
  patch        String?  // JSON stringified
  verification String?  // JSON stringified
  notAnalyzed  String   // JSON stringified
  prUrl        String?
  status       String
  createdAt    DateTime @default(now())
  /// v1.5 — Semantic-diff signal output (JSON stringified SemanticDiff per
  /// TRD §6.4). Nullable because v1.0 scans + scans with skipped signal
  /// won't have it. Used downstream by confidence scoring (Workstream #2).
  semanticDiff String?
  /// v2.1 / F21 — workspace-relative dir of the package this issue belongs
  /// to (e.g. 'packages/ui' or '.'). Null on legacy v1.5 issues. Drives the
  /// per-package chip on IssueCard and the dep-graph clustering.
  packageDir   String?
}

// (Fix #14) AgentLog removed — model was defined but never written by the runner.
// Reintroduce in v1.5 when we wire per-tool logging.

/// v2.1 / F22 — "Point at any API" inspection report. Pure analysis: no
/// repo, no PR, no sandbox. Each row is a shareable permalinkable report
/// (/inspect/[id]). `tenantId` is nullable for v2-local cohabitation; v3
/// cloud will fill it in per the cloud-readiness contract.
model Inspection {
  id           String   @id @default(cuid())
  packageName  String
  fromVersion  String
  toVersion    String
  /// JSON-stringified ApiReport (lib/agent/inspect.ts). SQLite has no
  /// native JSON column type — see TRD §10 for the precedent on other
  /// blobs (Issue.diagnosis, Scan.confidenceSummary, etc.).
  report       String
  createdAt    DateTime @default(now())
  /// v2.1 → v3 cloud-readiness seam (V2_PLAN §2.1). Null for local single-
  /// tenant runs; v3 will populate per scoped tenant on each row.
  tenantId     String?

  @@index([packageName, fromVersion, toVersion])
  @@index([createdAt])
}

// v1.5
model RejectionPattern {
  id              String   @id @default(cuid())
  depName         String?
  changeType      String?
  rejectionReason String
  prUrl           String
  createdAt       DateTime @default(now())
  embedding       Bytes?
}
