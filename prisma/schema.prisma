// Mendel data model — TRD §10

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Scan {
  id            String    @id @default(cuid())
  repoUrl       String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String
  issuesFound   Int       @default(0)
  prsOpened     Int       @default(0)
  totalTokens   Int       @default(0)
  schemaVersion String
  /// AES-256-GCM encrypted GitHub PAT (iv:authTag:ciphertext, all hex)
  encryptedPat  String?
  /// JSON string[] of the repo's dependency names (for the 3D dep graph)
  deps          String?
  /// Captured failure reason (Fix #2 — was emit-only via SSE, lost after the fact)
  errorMessage  String?
  /// v1.5 W#6 — aggregated calibration summary across this scan's issues.
  /// JSON-stringified ScanConfidenceSummary (see lib/agent/confidence/summary.ts).
  /// Null for v1.0 scans + scans where no issue had calibrated confidence data.
  confidenceSummary String?
  /// v2.0 / F20 — true when this scan opted into Phase C smoke-test.
  /// Read by /scan/[id] to know whether to render the 5th StageLane.
  /// Default false → v1.5 scans render the 4-lane view unchanged.
  smokeRequested Boolean @default(false)
  /// v2.1 / F21 — the workspace flavor detected by lib/agent/workspace/detect.ts:
  /// 'single' | 'pnpm' | 'npm' | 'yarn' | 'lerna' | 'nx' | 'turbo'. Null on
  /// legacy v1.5 scans (back-compat). Drives UI (monorepo line on S3, package
  /// chips on IssueCard, mini-stats on S4).
  workspaceKind String?
  /// v2.2 / F23 — the language adapter the runner picked for this scan:
  /// 'typescript' | 'python' | 'go' | 'rust'. Null on legacy v1.5/v2.0/v2.1
  /// scans (back-compat); drives the <LangBadge> UI chip + per-language
  /// confidence ceiling disclosure (§5b v2 rule 1).
  language      String?
  issues        Issue[]
  packages      ScanPackage[]
}

/// v2.1 / F21 — one row per member package enumerated by detectWorkspace().
/// For a single-package scan there's still one row with dir='.', so the
/// runtime never branches on "is this a monorepo?" — single is the N=1
/// special case (V2_PLAN.md §F21 integration rule).
model ScanPackage {
  id           String   @id @default(cuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  /// From the member package's own package.json `name`. Falls back to dir.
  name         String
  /// Path RELATIVE to the workspace root, e.g. 'packages/ui' or '.' for root.
  dir          String
  /// Path to that package's package.json, relative to the workspace root.
  manifestPath String
  /// Count of dependencies declared by THIS package (best-effort, summed
  /// across deps/devDeps/peerDeps). Used to rank packages under budget.
  depsCount    Int      @default(0)
  /// Count of issues opened for THIS package in this scan. Filled in by
  /// the runner as it iterates so the dashboard can show per-package stats.
  issuesFound  Int      @default(0)
  /// True iff the runner SCANNED this package; false iff it skipped under
  /// token budget (we still persist the row so "Not Analyzed" can name it).
  scanned      Boolean  @default(true)
  /// Reason a package was skipped (budget, error, etc.) — §5b honest.
  skipReason   String?
  createdAt    DateTime @default(now())

  @@index([scanId])
}

model Issue {
  id           String   @id @default(cuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id])
  type         String
  severity     String
  confidence   String   // JSON stringified — SQLite has no native JSON
  diagnosis    String   // JSON stringified
  patch        String?  // JSON stringified
  verification String?  // JSON stringified
  notAnalyzed  String   // JSON stringified
  prUrl        String?
  status       String
  createdAt    DateTime @default(now())
  /// v1.5 — Semantic-diff signal output (JSON stringified SemanticDiff per
  /// TRD §6.4). Nullable because v1.0 scans + scans with skipped signal
  /// won't have it. Used downstream by confidence scoring (Workstream #2).
  semanticDiff String?
  /// v2.1 / F21 — workspace-relative dir of the package this issue belongs
  /// to (e.g. 'packages/ui' or '.'). Null on legacy v1.5 issues. Drives the
  /// per-package chip on IssueCard and the dep-graph clustering.
  packageDir   String?
  /// v2.2 / F23 — the language adapter that produced this issue (mirrors
  /// Scan.language). On a polyglot monorepo a scan may end up with issues
  /// in mixed languages, so we tag each issue individually. Null on legacy.
  language     String?
  /// v2.3 / F24 — auto-merge outcome blob (JSON-stringified):
  ///   { verdict: 'merged' | 'skipped' | 'failed' | 'cancelled',
  ///     reasons: string[],          // every §5c reason logged (skip case)
  ///     mergedCommitSha?: string,   // when verdict='merged'
  ///     mergedAt?: string,          // ISO timestamp
  ///     failureMessage?: string }   // when verdict='failed'
  /// Null on legacy and on scans where auto-merge wasn't evaluated. Per
  /// CLAUDE.md §5c: every NO reason is logged — no silent action, no
  /// silent skip — so even a 'skipped' verdict carries the reasons.
  autoMerge    String?
}

/// v2.3 / F24 — per-tool / per-decision log. Resurrected from the
/// pre-v1.0 Fix #14 ("model defined but never written"); now WRITTEN
/// by the auto-merge gate per CLAUDE.md §5c ("every NO reason is logged
/// — no silent action, no silent skip"). Other gates can write here too
/// as v2.3 features land.
///
/// Distinct from Issue.autoMerge: that column holds the per-issue
/// terminal verdict; AgentLog holds the per-event audit trail (e.g.,
/// dwell-window start/cancel, merge API call result, capability check
/// failures). One Issue may produce multiple AgentLog rows.
model AgentLog {
  id        String   @id @default(cuid())
  scanId    String?
  issueId   String?
  /// Discriminator. Today: 'automerge.verdict' / 'automerge.dwell' /
  /// 'automerge.merge' / 'automerge.capability'. Open enum: new tools
  /// add new prefixes without a schema migration.
  kind      String
  /// JSON-stringified payload — shape depends on `kind`. Keeps the
  /// schema light + lets each event class evolve independently.
  payload   String
  createdAt DateTime @default(now())
  tenantId  String?

  @@index([scanId])
  @@index([issueId])
  @@index([kind])
  @@index([createdAt])
}

/// v2.1 / F22 — "Point at any API" inspection report. Pure analysis: no
/// repo, no PR, no sandbox. Each row is a shareable permalinkable report
/// (/inspect/[id]). `tenantId` is nullable for v2-local cohabitation; v3
/// cloud will fill it in per the cloud-readiness contract.
model Inspection {
  id           String   @id @default(cuid())
  packageName  String
  fromVersion  String
  toVersion    String
  /// JSON-stringified ApiReport (lib/agent/inspect.ts). SQLite has no
  /// native JSON column type — see TRD §10 for the precedent on other
  /// blobs (Issue.diagnosis, Scan.confidenceSummary, etc.).
  report       String
  createdAt    DateTime @default(now())
  /// v2.1 → v3 cloud-readiness seam (V2_PLAN §2.1). Null for local single-
  /// tenant runs; v3 will populate per scoped tenant on each row.
  tenantId     String?

  @@index([packageName, fromVersion, toVersion])
  @@index([createdAt])
}

// v1.5
model RejectionPattern {
  id              String   @id @default(cuid())
  depName         String?
  changeType      String?
  rejectionReason String
  prUrl           String
  createdAt       DateTime @default(now())
  embedding       Bytes?
}

/// v2.3 / F25 — per-repo monitor schedule.
///
/// The worker (worker/monitor.ts) loads every `enabled = true` row at
/// startup and registers a node-cron job per `cronExpression`. On fire
/// the worker calls `runScan` headless with the stored options.
///
/// **Honesty rules baked into the schema:**
///  - `enabled` defaults FALSE — same opt-in discipline as RepoSetting.
///    A new row is created OFF; the user MUST flip it on explicitly.
///  - `encryptedPat` stores the PAT under AES-256-GCM (CLAUDE.md §5 r5).
///    The worker decrypts on each fire — never logged, never returned in
///    REST responses.
///  - `repoUrl` is the canonical https://github.com/owner/name shape the
///    runner already accepts. We deliberately don't normalize-to-owner+repo
///    in the schema so the existing runner code path is unchanged.
///  - `lastFiredAt` lets the scheduler skip a job that ran recently (the
///    `MIN_GAP_SECONDS` policy in lib/agent/monitor/scheduler.ts) so a
///    misconfigured `* * * * *` doesn't drain rate limits.
///
/// `tenantId` is v3-ready (CLAUDE.md §1).
model MonitorSchedule {
  id              String    @id @default(cuid())
  /// "owner/name" — unique key. Mirrors RepoSetting's key shape.
  repoFullName    String    @unique
  /// Full clone URL the runner uses: https://github.com/owner/name
  repoUrl         String
  /// 5-field cron expression. Validated by the scheduler against a tight
  /// regex before being passed to node-cron. Default fires every 6 hours
  /// so a new row, if enabled, scans at a sane cadence.
  cronExpression  String    @default("0 */6 * * *")
  /// CLAUDE.md §5c r1-class opt-in. Default FALSE; the worker only
  /// registers a job when this flips true.
  enabled         Boolean   @default(false)
  /// AES-256-GCM-encrypted PAT (CLAUDE.md §5 rule 5). Never logged.
  encryptedPat    String
  /// Last successful scan run (worker writes this on completion). Used by
  /// the scheduler to enforce MIN_GAP_SECONDS — a too-frequent cron
  /// expression that already fired in the last gap is skipped honestly.
  lastFiredAt     DateTime?
  /// Last scan error (worker writes on failure). Null after a successful run.
  /// Lets the Settings UI surface "monitor is failing" without forcing the
  /// user to dig through AgentLog.
  lastErrorAt     DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenantId        String?

  @@index([repoFullName])
  @@index([enabled])
  @@index([tenantId])
}

/// v2.3 / F24 — per-repo auto-merge configuration.
///
/// **CLAUDE.md §5c rule 1: opt-in, default OFF — enforced at the SCHEMA level.**
/// A repo whose row doesn't exist (i.e., never configured) is implicitly
/// auto-merge-disabled. A row with `autoMergeEnabled = false` is also
/// auto-merge-disabled. The policy function (lib/agent/automerge/policy.ts)
/// requires the explicit `true` AND every other §5c envelope condition.
///
/// **Floor + dwell are bounded by the policy code, not by Prisma constraints.**
/// SQLite doesn't enforce CHECK constraints uniformly across drivers; we
/// hard-clamp `autoMergeConfidenceFloor ≥ standard threshold` in the
/// policy + hard-clamp `autoMergeDwellSeconds` to a sane range there.
/// Storing the raw user-supplied values here keeps the UI honest about
/// "what you asked for" vs. "what was effective."
///
/// `tenantId` is v3-ready (CLAUDE.md §1) — null today (single-tenant
/// local), keyed for cloud's multi-tenancy.
model RepoSetting {
  id                          String   @id @default(cuid())
  /// "owner/name" — unique key. v3 will partition by (tenantId, repoFullName).
  repoFullName                String   @unique
  /// CLAUDE.md §5c rule 1 — DEFAULT FALSE at schema level. Non-negotiable.
  autoMergeEnabled            Boolean  @default(false)
  /// CLAUDE.md §5c rule 3 — high confidence floor. Default 90.
  /// Anti-gaming (§5c rule 7): the policy hard-clamps ≥ standard threshold
  /// so a misconfigured low floor can't unlock auto-merge.
  autoMergeConfidenceFloor    Int      @default(90)
  /// CLAUDE.md §5c rule 6 — reversible cancelable dwell window before merge.
  /// Default 60s. Owner can cancel via UI during this window.
  autoMergeDwellSeconds       Int      @default(60)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  tenantId                    String?

  @@index([repoFullName])
  @@index([tenantId])
}
